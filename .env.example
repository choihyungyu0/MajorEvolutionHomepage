# Canonical production URL used for metadata, sitemap, and social previews.
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only OpenAI settings. Never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional scholarly metadata integrations used by Paper Bite.
# Keyless OpenAlex/Crossref requests still work at small scale.
OPENALEX_API_KEY=
CROSSREF_MAILTO=

# AI 사용량 제한 카운터를 여러 서버 인스턴스가 공유하려면 아래 두 개를 설정합니다.
# 비워 두면 인스턴스 메모리로 동작합니다. 이 경우 인스턴스마다 따로 세므로
# 한 사람의 연타는 막지만 전체 상한이 정확하지는 않습니다.
# Upstash Redis 콘솔의 REST URL과 토큰을 그대로 넣으면 됩니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google Analytics 4 web stream measurement ID (for example, G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
